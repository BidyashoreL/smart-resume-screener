# Copy this file to .env and fill in your own values. Never commit .env.

# --- LLM provider selection ---
# "gemini" (recommended/primary) or "openrouter" (optional fallback)
LLM_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional fallback provider - only needed if LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Database ---
DATABASE_URL=sqlite:///./resume_screener.db

# --- File upload constraints ---
MAX_FILE_SIZE_MB=10

# --- General ---
ENVIRONMENT=development
